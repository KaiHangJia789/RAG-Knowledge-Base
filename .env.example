# ============================================================
# RAG 项目环境变量示例
# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不要提交真实密钥。
# 未列出的配置项使用 app/config.py 中的默认值。
# ============================================================

# --- 大模型（DeepSeek，OpenAI 兼容接口）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# --- 向量化（阿里云百炼 DashScope，OpenAI 兼容接口）---
DASHSCOPE_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIM=1024

# --- 向量索引 ---
# 线上生效的切分策略：splitter / sentence / fixed_size / paragraph
CHUNK_STRATEGY=splitter

# --- 文档上传（MB 按 1024 * 1024 字节计算）---
MAX_UPLOAD_SIZE_MB=50
MAX_UPLOAD_BATCH_FILES=10
MAX_UPLOAD_BATCH_SIZE_MB=100

# --- PostgreSQL（与 docker-compose.yml 中 postgres 服务的开发默认值一致）---
# 生产环境请改用强密码，只写入服务器上的 .env
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=raguser
POSTGRES_PASSWORD=   # 必填：本地开发可设为任意强密码
POSTGRES_DB=ragdb

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- 登录 ---
# 登录 cookie 的签名密钥，生产必须设置。生成方式：openssl rand -hex 32
AUTH_SECRET_KEY=
# 生产走 HTTPS 时保持 True；本机 http 调试必须改为 False，否则浏览器不会发送 cookie
AUTH_COOKIE_SECURE=True

# --- 注册与邮件 ---
# 邮件中验证链接的前缀。本机开发填 http://localhost:3000，生产填站点域名
PUBLIC_BASE_URL=http://localhost:3000
# log：只把邮件内容写入日志，不真实发送（日志含验证链接，仅限本机）
# directmail：通过阿里云 DirectMail 发送
MAIL_BACKEND=log
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 已在 DirectMail 控制台验证通过的发信地址
ALIYUN_DM_ACCOUNT_NAME=
ALIYUN_DM_FROM_ALIAS=RAG 知识库

# --- 可观测性（LangFuse，可选）---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
